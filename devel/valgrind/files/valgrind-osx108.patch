From fd2587eecf994415b1b90536f500742c8491374a Mon Sep 17 00:00:00 2001
From: Mark Harris <mark.hsj@gmail.com>
Date: Sat, 31 Oct 2026 12:31:48 -0700
Subject: [PATCH] Bug 519604 - Fix undeclared identifier VKI_F_ADDFILESIGS on
 OS X 10.8

F_ADDFILESIGS is available beginning in Mac OS X 10.6, but Valgrind's
VKI_F_ADDFILESIGS was incorrectly defined within:
    #if DARWIN_VERS >= DARWIN_10_9
Prior to 59fe023ffb8c6cafb02a7c438cc6af286d5dc1cc this #if had no
effect, but that commit caused the definition to be omitted on
OS X 10.8.  One of the two uses was also guarded by a similar #if but
another was not, so because it was no longer defined the unguarded use
produced an error on OS X 10.8:

m_syswrap/syswrap-darwin.c:1967:9: error: use of undeclared identifier
'VKI_F_ADDFILESIGS'

These '#if's are removed because F_ADDFILESIGS is available beginning
in Mac OS X 10.6, and OS X 10.8 is the oldest supported version.
---
 coregrind/m_syswrap/syswrap-darwin.c | 2 --
 include/vki/vki-darwin.h             | 4 +---
 2 files changed, 1 insertion(+), 5 deletions(-)

diff --git a/coregrind/m_syswrap/syswrap-darwin.c b/coregrind/m_syswrap/syswrap-darwin.c
index 1468e5091..1958771e8 100644
--- coregrind/m_syswrap/syswrap-darwin.c
+++ coregrind/m_syswrap/syswrap-darwin.c
@@ -1780,9 +1780,7 @@ static const HChar *name_for_fcntl(UWord cmd) {
       F(F_GETPATH);
       F(F_PATHPKG_CHECK);
       F(F_ADDSIGS);
-#     if DARWIN_VERS >= DARWIN_10_9
       F(F_ADDFILESIGS);
-#     endif
 #     if DARWIN_VERS >= DARWIN_10_11
       F(F_ADDFILESIGS_FOR_DYLD_SIM);
       F(F_BARRIERFSYNC);
diff --git a/include/vki/vki-darwin.h b/include/vki/vki-darwin.h
index d559291c7..73de53690 100644
--- include/vki/vki-darwin.h
+++ include/vki/vki-darwin.h
@@ -410,9 +410,7 @@ typedef uint32_t vki_u32;
 #define VKI_F_LOG2PHYS	F_LOG2PHYS
 #define VKI_F_GETPATH	F_GETPATH
 #define VKI_F_ADDSIGS	F_ADDSIGS
-#if DARWIN_VERS >= DARWIN_10_9
-# define VKI_F_ADDFILESIGS  F_ADDFILESIGS
-#endif
+#define VKI_F_ADDFILESIGS  F_ADDFILESIGS
 #if DARWIN_VERS >= DARWIN_10_11
 # define VKI_F_ADDFILESIGS_FOR_DYLD_SIM  F_ADDFILESIGS_FOR_DYLD_SIM
 # define VKI_F_BARRIERFSYNC              F_BARRIERFSYNC
-- 
2.56.0

